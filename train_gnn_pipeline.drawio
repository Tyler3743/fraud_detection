<mxfile host="app.diagrams.net">
  <diagram name="train-gnn pipeline" id="train-gnn-pipeline">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="n1" value="1. paths.py&#10;Xác định đường dẫn input/output" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n2" value="2. temporal_split_index.py&#10;Chia train/val/test theo thời gian (60/20/20), check leak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="120" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n3" value="3. feature_transaction.py&#10;Feature mức giao dịch (log amount, cross-bank/currency, self-loop, hour/dow sin-cos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="220" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n4" value="4. feature_node.py&#10;Feature as-of mức node và cặp (src, dest) — tốn RAM nhất" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="330" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n5" value="5. feature_edge.py&#10;Gộp feature cạnh theo cửa sổ lũy tiến kiểu Altman, assert check leak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="440" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n6" value="6. assemble_txn.py&#10;Ghép feature giao dịch + node thành ma trận (~90 cột), lưu parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="280" y="550" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n7" value="7. build_graph.py&#10;Dựng 3 đồ thị PyG lũy tiến (train / train+val / train+val+test)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="280" y="660" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n8" value="8. metrics.py&#10;Định nghĩa hàm đánh giá (F1, PR-AUC, recall@FPR1%, precision@k)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="280" y="770" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="n9" value="9. train_gnn.py&#10;Huấn luyện EdgeSAGE (sage / sage_noedge, 4 seed), chọn winner theo PR-AUC val, xuất embedding + điểm dự đoán vào scores/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="270" y="880" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="n10" value="10. Kết quả&#10;Đọc results.csv, in bảng metric theo model/split" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="1010" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n11" value="11. Kiểm tra dung lượng output&#10;Giới hạn 20GB trong /kaggle/working" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="1110" width="300" height="60" as="geometry" />
        </mxCell>

        <mxCell id="n12" value="12. Vẽ hình&#10;PR curve... từ winner.json + embedding seed đại diện (gần trung vị PR-AUC val)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="280" y="1210" width="300" height="70" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="n1" target="n2"><mxGeometry relative="1" as="geometry" /></mxCell>
